# ============================================================
# Variables de entorno — Mascotas Perdidas
# Copiar a .env (nunca commitear .env) y rellenar los valores.
# Usado por docker-compose tanto en local como en el VPS.
# ============================================================

# --- Base de datos MariaDB ---
MYSQL_ROOT_PASSWORD=cambia_esto
MYSQL_DATABASE=mascotas_perdidas
MYSQL_USER=mp_user
MYSQL_PASSWORD=cambia_esto

# --- Spring Boot (se inyectan en el contenedor) ---
SPRING_DATASOURCE_URL=jdbc:mariadb://mariadb-db:3306/mascotas_perdidas?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Europe/Madrid
SPRING_DATASOURCE_USERNAME=mp_user
SPRING_DATASOURCE_PASSWORD=cambia_esto

# JWT: generar con: openssl rand -base64 32
APP_JWT_SECRET=cambia_esto_por_un_secreto_base64_de_256_bits

# CORS: lista de orígenes permitidos separados por coma
# En local: http://localhost:4200
# En VPS:   http://localhost:4200,https://mascotaperdida.vercel.app
APP_CORS_ORIGINS=http://localhost:4200,https://mascotaperdida.vercel.app

# Directorio de uploads dentro del contenedor (dejar como está salvo que cambies el Dockerfile)
APP_UPLOAD_DIR=/app/uploads

# URL pública completa de la API — dejar vacío en local.
# En VPS: https://api.tudominio.com  (una vez tengas dominio y HTTPS)
APP_PUBLIC_API_URL=

# Ajuste de memoria JVM (útil para VPS con RAM limitada)
JAVA_TOOL_OPTIONS=-Xmx400m -Xms200m
